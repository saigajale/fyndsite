# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real secrets.

# Which nearby-healthcare provider to use: "overpass" (default) or "google".
# Leave unset to use Overpass. Google is never selected silently — it only
# activates when this is explicitly set to "google" AND the key below is
# configured. See lib/healthcare/README.md for full setup details.
HEALTHCARE_PROVIDER=overpass

# Server-side Google Places API key. Required only when
# HEALTHCARE_PROVIDER=google. Leave empty for local development with the
# default Overpass provider. See lib/healthcare/README.md before enabling.
GOOGLE_MAPS_SERVER_API_KEY=

# Optional: comma-separated Overpass endpoint fallback list. Only needed to
# override the built-in defaults (overpass-api.de, overpass.kumi.systems,
# overpass.private.coffee).
# OVERPASS_ENDPOINTS=
